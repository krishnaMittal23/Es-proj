<?xml version="1.0"?>
<sdf version="1.9">
  <model name="camo_drone">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial><mass>1.5</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz></inertia></inertial>
      <collision name="col"><geometry><box><size>0.5 0.5 0.12</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.28 0.28 0.09</size></box></geometry>
        <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      <visual name="arm1"><pose>0 0 0 0 0 0.785</pose><geometry><box><size>0.7 0.04 0.03</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm2"><pose>0 0 0 0 0 -0.785</pose><geometry><box><size>0.7 0.04 0.03</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="r1"><pose>0.25 0.25 0.04 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry><material><diffuse>0.9 0.3 0.1 0.8</diffuse></material></visual>
      <visual name="r2"><pose>-0.25 0.25 0.04 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 0.8</diffuse></material></visual>
      <visual name="r3"><pose>0.25 -0.25 0.04 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry><material><diffuse>0.9 0.3 0.1 0.8</diffuse></material></visual>
      <visual name="r4"><pose>-0.25 -0.25 0.04 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 0.8</diffuse></material></visual>
      <!-- forward camera tilted 50 deg down -->
      <sensor name="camera" type="camera">
        <pose>0.15 0 -0.02 0 0.87 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <topic>/camo/camera/image</topic>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.2</near><far>400</far></clip>
        </camera>
      </sensor>
      <!-- ground-truth 2D boxes for labelled classes (used for dataset + scoring) -->
      <sensor name="bbox_camera" type="boundingbox_camera">
        <pose>0.15 0 -0.02 0 0.87 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <topic>/camo/camera/boxes</topic>
        <camera>
          <box_type>2d</box_type>
          <horizontal_fov>1.25</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.2</near><far>400</far></clip>
        </camera>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/camo/cmd_vel</topic></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>camo_drone</robot_base_frame>
      <odom_topic>/camo/odom</odom_topic>
    </plugin>
  </model>
</sdf>

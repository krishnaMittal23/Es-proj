Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane Cell Count: 24
      Cell Size: 10
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Drone path
      Topic: {Value: /camo/path}
      Color: 255; 200; 0
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Found targets
      Topic: {Value: /camo/found_markers}
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Annotated camera
      Topic: {Value: /camo/image_annotated}
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Drone
      Topic: {Value: /camo/odom}
      Keep: 1
      Enabled: true
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 260
      Pitch: 1.0
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0}
    Saved: ~
